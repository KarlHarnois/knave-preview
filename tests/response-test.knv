(use response content-type file-found redirect
              response-head)

(deftest names-the-html-content-type
  (assert (= (content-type "index.html") "text/html; charset=utf-8")))

(deftest names-the-javascript-content-type
  (assert (= (content-type "grid-overlay.js")
             "text/javascript; charset=utf-8")))

(deftest names-the-font-content-type
  (assert (= (content-type "iosevka-regular.woff2") "font/woff2")))

(deftest names-the-xml-content-type
  (assert (= (content-type "sitemap.xml")
             "application/xml; charset=utf-8")))

(deftest names-the-text-content-type
  (assert (= (content-type "robots.txt") "text/plain; charset=utf-8")))

(deftest serves-markdown-as-text
  (assert (= (content-type "index.html.md")
             "text/plain; charset=utf-8")))

(deftest falls-back-to-a-binary-content-type
  (assert (= (content-type "archive.zip") "application/octet-stream")))

(deftest states-the-body-length
  (assert (= (response-head (ref (file-found "a.txt" (vec 104 105))))
             "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")))

(deftest names-the-redirect-location
  (assert (= (response-head (ref (redirect (str "/docs/"))))
             "HTTP/1.1 301 Moved Permanently\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 6\r\nLocation: /docs/\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")))
