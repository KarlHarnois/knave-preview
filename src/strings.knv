(export before contains? ends-with? find-from starts-with?
        trim-leading)

(def starts-with?
  (rust "{0}.starts_with({1})"
    (fn ((ref str) (ref str)) bool)))

(def ends-with?
  (rust "{0}.ends_with({1})"
    (fn ((ref str) (ref str)) bool)))

(def trim-leading
  (rust "{0}.trim_start_matches({1})"
    (where ('a)
      (fn ((ref 'a str) (ref str))
        (ref 'a str)))))

(def contains?
  (rust "{0}.contains({1})"
    (fn ((ref str) (ref str)) bool)))

(def find-from
  (rust "{0}[usize::try_from({2}).expect(\"find-from takes a position of 0 or more\")..].find({1}).map(|offset| offset as i64 + {2})"
    (fn ((ref str) (ref str) int)
      (option int))))

(type before
  (fn ((ref str) (ref str)) (ref str)))

(defn before (text separator)
  (match (find-from text separator 0)
    (none text)
    ((some found) (subs text 0 found))))
