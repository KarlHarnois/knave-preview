(use answer answer-waiting-connections)

(use socket accept-without-waiting bind-listener
            sleep-milliseconds)

(use watch fingerprint-directories)

(export ->preview preview serve)

(defstruct preview
  :directory string
  :port u16
  :watched (vec string))

(def host "127.0.0.1")

(def poll-milliseconds 50)

(type serve
  (where (a (b display))
    (fn (preview (fn () (result a b)))
      (result unit io-error))))

(defn serve (settings build)
  (let (listener (try (listen (ref settings)))
        fingerprint (try (current-fingerprint (ref settings))))
    (report-build (ref settings) (build))
    (println (str "Previewing "
                  (:directory settings)
                  " at http://"
                  (address (ref settings))
                  "/"))
    (ok (run (ref settings) (ref listener) build fingerprint))))

(defn listen (settings)
  (let (listener (try (bind-listener (as-str (address settings)))))
    (try (accept-without-waiting (ref listener)))
    (ok listener)))

(defn address (settings)
  (str host ":" (:port settings)))

(defn run (settings listener build fingerprint)
  (answer-waiting-connections (as-str (:directory settings))
                              listener)
  (sleep-milliseconds poll-milliseconds)
  (let (latest (latest-fingerprint settings (ref fingerprint)))
    (if (= latest fingerprint)
      (do)
      (report-build settings (build)))
    (recur settings listener build latest)))

(defn latest-fingerprint (settings fingerprint)
  (match (current-fingerprint settings)
    ((err _) (clone fingerprint))
    ((ok current) current)))

(defn current-fingerprint (settings)
  (fingerprint-directories (ref (:watched settings))))

(defn report-build (settings outcome)
  (match outcome
    ((err problem) (eprintln (str "build failed: " problem)))
    ((ok _) (println (str "Built " (:directory settings))))))
