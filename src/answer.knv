(module
  "Answers each waiting connection with a file from the preview directory.")

(use files directory? read-bytes)
(use request index-of request-file)

(use response ->response content-type not-found
              response-head)

(use socket limit-read-wait limit-write-wait next-connection
            read-request-line wait-for-reads write-body
            write-text)

(export answer-waiting-connections response-for)

(def request-wait-milliseconds 250)

(def response-wait-milliseconds 1000)

(defn answer-waiting-connections (directory listener)
  (match (next-connection listener)
    ((err problem) (report-request-failure problem))
    ((ok none) (do))
    ((ok (some stream))
     (match (answer-connection directory (ref stream))
       ((err problem) (report-request-failure problem))
       ((ok _) (do)))
     (recur directory listener))))

(defn report-request-failure (problem)
  (eprintln (str "preview request failed: " problem)))

(defn answer-connection (directory stream)
  (try (wait-for-reads stream))
  (try (limit-read-wait stream request-wait-milliseconds))
  (try (limit-write-wait stream response-wait-milliseconds))
  (let (request-line (try (read-request-line stream)))
    (if (empty? request-line)
      (ok (do))
      (send-response stream
                     (ref (response-for directory (as-str request-line)))))))

(defn send-response (stream reply)
  (let (head (response-head (as-str (:status reply))
                            (as-str (:file-type reply))
                            (len (:body reply))))
    (try (write-text stream (as-str head)))
    (write-body stream (ref (:body reply)))))

(defn response-for (directory request-line)
  (match (request-file request-line)
    (none (not-found))
    ((some file)
     (file-response directory
                    (as-str (directory-index directory (as-str file)))))))

(defn directory-index (directory file)
  (if (directory? (as-str (str directory "/" file)))
    (index-of file)
    (str file)))

(defn file-response (directory file)
  (match (read-bytes (as-str (str directory "/" file)))
    ((err _) (not-found))
    ((ok body)
     (->response :status (str "200 OK")
                 :file-type (str (content-type file))
                 :body body))))
