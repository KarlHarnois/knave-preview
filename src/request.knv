(use strings before contains? ends-with? find-from
             starts-with? trim-leading)

(export request-file request-query)

(def get-prefix "GET ")

(def parent-segment "..")

(def index-file "index.html")

(defn request-file (request-line)
  (match (request-target request-line)
    (none none)
    ((some target) (file-for-url (path-of-target target)))))

(defn request-query (request-line)
  (match (request-target request-line)
    (none (str ""))
    ((some target) (str (query-of target)))))

(defn request-target (request-line)
  (if (starts-with? request-line get-prefix)
    (target-after-method request-line)
    none))

(defn target-after-method (request-line)
  (let (target-start (len get-prefix))
    (match (find-from request-line " " target-start)
      (none none)
      ((some target-end)
       (some (subs request-line target-start target-end))))))

(defn path-of-target (target)
  (before (before target "?") "#"))

(defn query-of (target)
  (let (without-fragment (before target "#"))
    (match (find-from without-fragment "?" 0)
      (none "")
      ((some start)
       (subs without-fragment start (len without-fragment))))))

(defn file-for-url (url-path)
  (if (safe-url? url-path)
    (some (file-below-root (trim-leading url-path "/")))
    none))

(defn safe-url? (url-path)
  (and (starts-with? url-path "/")
       (not (contains? url-path parent-segment))))

(defn file-below-root (relative)
  (if (directory-path? relative)
    (index-of relative)
    (str relative)))

(defn index-of (directory) (str directory index-file))

(defn directory-path? (path)
  (or (empty? path) (ends-with? path "/")))
