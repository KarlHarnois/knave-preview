(use files files-under vanished?)

(export fingerprint-directories)

(def modified-nanos
  (rust "{{ let {!path} = {0}; std::fs::metadata({!path}).and_then(|found| found.modified()).map(|modified| modified.duration_since(std::time::UNIX_EPOCH).map_or(0, |elapsed| elapsed.as_nanos())).map_err(|error| std::io::Error::new(error.kind(), String::from({!path}) + \": \" + &error.to_string())) }}"
    (fn ((ref str)) (result u128 io-error))))

(defn fingerprint-directories (directories)
  (join-results directories directory-fingerprint))

(defn directory-fingerprint (directory)
  (let (files (try (files-under directory)))
    (sort! files)
    (join-results (ref files)
      (fn (file) (file-stamp directory file)))))

(defn file-stamp (directory file)
  (let (full-path (str directory "/" file))
    (match (modified-nanos (as-str full-path))
      ((ok modified) (ok (str full-path "@" modified "\n")))
      ((err problem) (skip-vanished problem)))))

(defn skip-vanished (problem)
  (if (vanished? (ref problem))
    (ok (str ""))
    (err problem)))

(type join-results
  (fn (_ (fn (_) (result _ _))) _))

(defn join-results (items produce)
  (reduce (iter items) (ok (str ""))
    (fn (joined item)
      (ok (str (try joined)
               (try (produce (as-str item))))))))
