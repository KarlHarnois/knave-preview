(use strings ends-with?)

(export content-type file-found not-found redirect
        response-head)

(defstruct response
  :status string
  :file-type string
  :location (option string)
  :body (vec u8))

(def text-type "text/plain; charset=utf-8")

(def text-bytes
  (rust "{0}.as_bytes().to_vec()"
    (fn ((ref str)) (vec u8))))

(defn content-type (file)
  (cond
    ((ends-with? file ".html") "text/html; charset=utf-8")
    ((ends-with? file ".css") "text/css; charset=utf-8")
    ((ends-with? file ".js") "text/javascript; charset=utf-8")
    ((ends-with? file ".svg") "image/svg+xml")
    ((ends-with? file ".xml") "application/xml; charset=utf-8")
    ((ends-with? file ".woff2") "font/woff2")
    ((or (ends-with? file ".txt") (ends-with? file ".md"))
     text-type)
    (else "application/octet-stream")))

(defn response-head (reply)
  (str "HTTP/1.1 "
       (:status reply)
       "\r\n" "Content-Type: "
       (:file-type reply)
       "\r\n" "Content-Length: "
       (len (:body reply))
       "\r\n"
       (location-line reply)
       "Cache-Control: no-store\r\n"
       "Connection: close\r\n\r\n"))

(defn location-line (reply)
  (match (ref (:location reply))
    (none (str ""))
    ((some target) (str "Location: " target "\r\n"))))

(defn file-found (file body)
  (->response :status (str "200 OK")
              :file-type (str (content-type file))
              :location none
              :body body))

(defn redirect (target)
  (->response :status (str "301 Moved Permanently")
              :file-type (str text-type)
              :location (some target)
              :body (text-bytes "Moved\n")))

(defn not-found ()
  (->response :status (str "404 Not Found")
              :file-type (str text-type)
              :location none
              :body (text-bytes "Not found\n")))
