(module "Builds responses and the head that precedes their body.")

(use strings ends-with?)

(export ->response content-type not-found response-head)

(defstruct response
  :status string
  :file-type string
  :body (vec u8))

(def text-type "text/plain; charset=utf-8")

(def text-bytes
  (rust "{0}.as_bytes().to_vec()"
    (fn ((ref str)) (vec u8))))

(defn content-type (file)
  (cond
    ((ends-with? file ".html") "text/html; charset=utf-8")
    ((ends-with? file ".css") "text/css; charset=utf-8")
    ((ends-with? file ".js") "text/javascript; charset=utf-8")
    ((ends-with? file ".svg") "image/svg+xml")
    ((ends-with? file ".xml") "application/xml; charset=utf-8")
    ((ends-with? file ".woff2") "font/woff2")
    ((or (ends-with? file ".txt") (ends-with? file ".md"))
     text-type)
    (else "application/octet-stream")))

(defn response-head (status file-type body-length)
  (str "HTTP/1.1 " status "\r\n" "Content-Type: " file-type
       "\r\n" "Content-Length: " body-length "\r\n"
       "Cache-Control: no-store\r\n"
       "Connection: close\r\n\r\n"))

(defn not-found ()
  (->response :status (str "404 Not Found")
              :file-type (str text-type)
              :body (text-bytes "Not found\n")))
